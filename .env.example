# KeyForCars CRM — Vercel environment variables. See docs/keyforcars-installatie.md §4.

# ── Install ───────────────────────────────────────────────────────
CRM_INSTALL=keyforcars
# Workshop calendar + agent: unset = on, 0 = off (build time).
KFC_WORKSHOP=

# ── Supabase (project lzdwxkhlscsitstxdgar) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting (own Upstash database) ──────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── E-mail and inbox (own Resend account/domain) ──────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
INBOX_EMAIL=
# Draft replies in Gesprekken (own Anthropic key; optional)
ANTHROPIC_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────
CRON_SECRET=

# ── Stock store ───────────────────────────────────────────────────
KFC_STOCK_STORE=supabase

# ── ElevenLabs (KeyForCars' OWN workspace) ────────────────────────
ELEVENLABS_API_KEY=
KFC_REVIEW_AGENT_IDS=
KFC_WORKSHOP_AGENT_TOKEN=

# ── KeyForCars install: WooCommerce order import ─────────────────────
# One REST API key pair per shop (WooCommerce → Settings → Advanced → REST
# API, permission Read/Write: the CRM writes exactly one thing back, the
# status `completed` when it ships). The webhook secret is what you type when
# creating the order.created / order.updated webhooks pointing at
# https://<crm host>/api/woo/<shop>. Unset = that shop is not imported.
WOO_KEYFORCARS_KEY=
WOO_KEYFORCARS_SECRET=
WOO_KEYFORCARS_WEBHOOK_SECRET=
WOO_KLAPSLEUTELS_KEY=
WOO_KLAPSLEUTELS_SECRET=
WOO_KLAPSLEUTELS_WEBHOOK_SECRET=

# ── KeyForCars: shipping labels via Sendcloud (optional) ─────────────
# Unset = the CRM prints its own label with a QR code and the carrier is
# typed by hand. Set = a parcel with label is created at Sendcloud on
# "Verzendlabel"; carrier and tracking come back onto the order.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_SHIPPING_METHOD_ID=

# Local development only. Enables the isolated Shipping queue and test labels.
KFC_SHIPPING_TEST=0

# ── Inbox: WhatsApp (Meta Cloud API), e-mail (Resend inbound), AI drafts ──
# See docs/inbox.md. All optional: an unset channel is simply not connected.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
RESEND_WEBHOOK_SECRET=
INBOX_EMAIL=
ANTHROPIC_API_KEY=
# Emergency stop for self-sent replies: 0 = every 'auto' thread behaves as 'draft'.
INBOX_AI_AUTO=1

# PostNL labels for web orders (src/lib/kfcPostnl.ts). With these set, "Verzendlabel" makes a PostNL
# shipment; without them Sendcloud or the CRM's own label is used. Code and number come from the contract.
POSTNL_API_KEY=
POSTNL_CUSTOMER_CODE=
POSTNL_CUSTOMER_NUMBER=
POSTNL_SENDER_STREET=
POSTNL_SENDER_ZIPCODE=
POSTNL_SENDER_CITY=
# Optional: POSTNL_SENDER_COMPANY, POSTNL_SENDER_COUNTRY (NL), POSTNL_COLLECTION_LOCATION,
# POSTNL_PRODUCT_NL (3085), POSTNL_PRODUCT_BE (4946), POSTNL_PRODUCT_EU (4952),
# POSTNL_BARCODE_SERIE (000000000-999999999), POSTNL_SANDBOX=1 (PostNL's test server; labels are not valid).
